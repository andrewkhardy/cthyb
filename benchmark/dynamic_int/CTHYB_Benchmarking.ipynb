  {
   "cell_type": "markdown",
   "id": "8d37ff8c",
   "metadata": {},
   "source": [
    "### CTSEG compared to CTHYB with only $J_\\perp$ dynamical interactions"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b4f48084",
   "metadata": {},
   "source": [
    "### CTSEG compared to CTHYB with only diagonal $D_0$ dynamical interactions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "20e43dc3",
   "metadata": {},
   "outputs": [],
   "source": [
    "n_tau_bosonic = 5000\n",
    "w0 = 0.35\n",
    "beta = 10.0\n",
    "g02 = -0.35"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "bc6c3b6d",
   "metadata": {},
   "outputs": [],
   "source": [
    "from triqs.gf.descriptors import Function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "96db075a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# phonon mediated interaction\n",
    "d_tau = GfImTime(indices = [0], beta = beta, statistic = \"Boson\", n_points = n_tau_bosonic+3)\n",
    "wp = w0\n",
    "D_iw = GfImFreq(indices = [0], beta = beta, statistic = \"Boson\", n_points = n_tau_bosonic//2)\n",
    "d_tau = GfImTime(indices = [0], beta = beta, statistic = \"Boson\", n_points = n_tau_bosonic+3)\n",
    "D_iw << Function(lambda w: 2 * g02/wp * wp**2 / (w**2 - wp**2))\n",
    "d_tau << Fourier(D_iw)\n",
    "D_tau = Block2Gf(['up', 'down'], ['up', 'down'], [[d_tau, d_tau], [d_tau, d_tau]])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "37198c70",
   "metadata": {},
   "outputs": [],
   "source": [
    "Dleg= fit_legendre(d_tau, order=10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "f28d00d1",
   "metadata": {},
   "outputs": [],
   "source": [
    "beta = d_tau.mesh.beta\n",
    "statistic = d_tau.mesh.statistic\n",
    "\n",
    "dense_tau_mesh = MeshImTime(beta=beta, S=statistic, n_tau=n_tau_bosonic+3)\n",
    "\n",
    "D_tau_recon = GfImTime(mesh=dense_tau_mesh, target_shape=d_tau.target_shape)\n",
    "\n",
    "for tau in D_tau_recon.mesh:\n",
    "    D_tau_recon[tau] = Dleg(tau.value)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "46141515",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x900 with 1 Axes>"
      ]
     },
